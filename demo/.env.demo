# Environment for the live demo only. demo/dev.ts merges it into process.env
# before starting Next, and @next/env leaves already-set keys alone, so these
# win over the portal's .env.local.
#
#   1. DATABASE_URL is the throwaway Docker Postgres (npm run demo:db), never Neon.
#   2. Mail, SMS and Luma keys are blanked: confirming a car on stage creates
#      in-app notifications but sends nothing, and no Luma call is made.
#   3. The demo runs on 127.0.0.1, not localhost, so its sign-in cookie can't
#      clobber a dev session on localhost:4000.

DATABASE_URL=postgresql://demo:demo@127.0.0.1:55433/sundays_demo
AUTH_URL=http://127.0.0.1:4020
ADMIN_EMAILS=host@sundays.example
NEXT_DIST_DIR=.next-demo

RESEND_API_KEY=
AUTH_RESEND_KEY=
LUMA_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
CRON_SECRET=
