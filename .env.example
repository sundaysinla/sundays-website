# Database (Neon Postgres)
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# Auth.js
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:4000"

# Google OAuth (https://console.cloud.google.com/apis/credentials)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Resend (magic links + notifications)
AUTH_RESEND_KEY=""
RESEND_API_KEY=""
EMAIL_FROM="Sundays in LA <onboarding@resend.dev>"

# Luma Calendar API (Settings → Developer on sundaysinla calendar)
LUMA_API_KEY=""

# Mapbox Geocoding
MAPBOX_TOKEN=pk.your-public-token   # public (pk.) token: geocoding server-side + map/autocomplete in the browser

# Admin portal (comma-separated emails; hosts who can edit car groups)
ADMIN_EMAILS=""

# Twilio (optional) — carpool texts for confirmations and car-group messages
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=+13105550100

# Vercel cron (Monday "who did you meet?" email). Any long random string; Vercel sends it as a bearer token.
CRON_SECRET=
